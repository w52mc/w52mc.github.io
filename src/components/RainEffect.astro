<!--
  江南烟雨：远/中/近三层淡墨雨丝随风斜落，远淡近浓；
  雨点落在远近不一的水面，泛起两圈错开时序的墨色涟漪。
  背景垫一块 mist-canvas（z-index:-1，位于正文之后）：
  上留白、下写水——淡彩三叠远山以大气透视层层入雾，
  近岸树林是画面最重的一笔，水平线上一道亮雾；
  水面如镜倒映全幅山影（分条微扭，随波轻漾），
  三叶扁舟远近错落其上。整体浓淡由 WASH 一个数总控。
  data-astro-rerun 保证视图切换后重新绑定；尊重系统"减少动态效果"设置。
-->
<canvas id="mist-canvas" class="mist-canvas" aria-hidden="true"></canvas>
<canvas id="rain-canvas" class="rain-canvas" aria-hidden="true"></canvas>

<script is:inline data-astro-rerun>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var c = document.getElementById("rain-canvas");
    if (!c || c.__raf) return;
    var ctx = c.getContext("2d");
    var m = document.getElementById("mist-canvas");
    var mctx = m ? m.getContext("2d") : null;
    var DPR = Math.min(window.devicePixelRatio || 1, 2);
    var T0 = performance.now();
    var last = T0;
    var RIPPLE_LIFE = 100; // 涟漪寿命，约 1.7s（60fps 折算）

    // 三层雨（远/中/近），参数顺序：
    // [亮墨透明度, 暗墨透明度, 长度下限, 长度幅度, 速度下限, 速度幅度, 落点带上缘, 落点带宽]
    var LAYERS = [
      [0.1, 0.13, 7, 5, 1.3, 0.6, 0.64, 0.09],
      [0.17, 0.21, 12, 6, 2.0, 0.7, 0.73, 0.09],
      [0.26, 0.32, 18, 8, 2.8, 0.8, 0.82, 0.18],
    ];
    var SHARE = [0.45, 0.35, 0.2]; // 远处雨丝最密，朦胧成幕

    // ── 远景（mist-canvas）：淡彩三叠远山入雾、亮雾、镜面水影、扁舟 ──
    var WATER = 0.64; // 水平线（屏高比）：以下为水，雨点尽落水中
    var RANGES = [ // 由远及近：[基线h比, 峰幅h比, 波长(占屏宽比), alpha]
      [0.47, 0.075, 0.44, 0.13],
      [0.53, 0.06, 0.31, 0.18],
      [0.585, 0.045, 0.22, 0.23],
    ];
    var TREELINE = [0.575, 0.045, 0.42]; // 近岸树林：[基线h比, 起伏h比, alpha]
    var WASH = 1; // 全局浓淡总闸：整体调淡/调浓只改这一个数

    // 固定种子的伪随机：山形树形永远是同一幅，resize 重算也不会变样
    var SEED = 20260912;
    function mkRnd(s) {
      return function () {
        s = (s + 0x6d2b79f5) | 0;
        var t = Math.imul(s ^ (s >>> 15), 1 | s);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    var rnd = mkRnd(SEED);
    var MT = { ready: false, theme: "", waterY: 0, boats: [], ops: [] };

    var D = { layers: [[], [], []], ripples: [] };

    function newDrop(L, filled) {
      var p = LAYERS[L];
      return {
        x: Math.random() * c.__w,
        y: filled ? Math.random() * c.__h : -20,
        l: p[2] + Math.random() * p[3],
        v: p[4] + Math.random() * p[5],
        b: Math.random(), // 落点在落点带内的位置：存下来，resize 后不变
      };
    }

    function ripple(x, y) {
      if (D.ripples.length > 120) return; // 大屏保险
      // 透视：离水平线越远的落点越近，涟漪越大
      var depth = Math.max(0, Math.min(1, (y / c.__h - WATER) / (1 - WATER)));
      var max = (6 + 28 * depth) * (0.85 + Math.random() * 0.3);
      D.ripples.push({ x: x, y: y, max: max, t: 0 });
      if (Math.random() < 0.65)
        D.ripples.push({ x: x, y: y, max: max * 0.72, t: -0.28 }); // 第二圈迟些泛起
    }

    function drawBoat(g2, x, y, s, a, rgb2, rod) {
      var hw = 16 * s, ink = "rgba(" + rgb2 + ",";
      g2.lineWidth = 1.5 * s;
      g2.strokeStyle = ink + a.toFixed(3) + ")";
      g2.beginPath(); // 船身：一弯月牙
      g2.moveTo(x - hw, y - 2 * s);
      g2.bezierCurveTo(x - hw * 0.45, y + 5 * s, x + hw * 0.45, y + 5 * s, x + hw, y - 3 * s);
      g2.stroke();
      g2.beginPath(); // 乌篷
      g2.arc(x - hw * 0.12, y - 4 * s, 6.5 * s, Math.PI, Math.PI * 2);
      g2.closePath();
      g2.fillStyle = ink + (a * 0.85).toFixed(3) + ")";
      g2.fill();
      if (rod) {
        g2.beginPath(); // 蓑翁执竿
        g2.moveTo(x + hw * 0.4, y - 3 * s);
        g2.lineTo(x + hw * 0.4, y - 12 * s);
        g2.moveTo(x + hw * 0.4, y - 11 * s);
        g2.lineTo(x + hw + 22 * s, y + 2 * s);
        g2.stroke();
      }
    }

    function paint(g2, w) {
      // 把远景那批形状画到任意 2D 上下文（本体直接画；倒影用镜像变换后画同一批）
      for (var i = 0; i < MT.ops.length; i++) {
        var o = MT.ops[i];
        if (o.haze) {
          var hg = g2.createLinearGradient(0, o.y, 0, o.y + o.h);
          hg.addColorStop(0, "rgba(" + o.rgb + ",0)");
          hg.addColorStop(0.5, "rgba(" + o.rgb + "," + o.a.toFixed(3) + ")");
          hg.addColorStop(1, "rgba(" + o.rgb + ",0)");
          g2.fillStyle = hg;
          g2.fillRect(0, o.y, w, o.h);
        } else {
          var fg = g2.createLinearGradient(0, o.y0, 0, o.y1);
          fg.addColorStop(0, "rgba(" + o.rgb + "," + o.a0.toFixed(3) + ")");
          fg.addColorStop(1, "rgba(" + o.rgb + "," + o.a1.toFixed(3) + ")");
          g2.fillStyle = fg;
          g2.fill(o.fill);
        }
      }
    }

    function buildScene() {
      // 远景：三叠淡彩远山 + 近岸树岛 + 水平亮雾；水线以下镜像成倒影。
      // 两点要紧：① 形状由固定种子生成、尺寸全按屏宽屏高取比例，resize 只等比缩放；
      //          ② 不用 ctx.filter 做模糊——Safari 不支持该 API，
      //             一用就变成"Chrome 糊、Safari 清晰"的浏览器差异。
      rnd = mkRnd(SEED); // 每次重建都从同一颗种子开始，山形恒定
      var w = c.__w, h = c.__h;
      var waterY = Math.round(h * WATER);
      var dark = MT.theme === "dark";
      var ink = dark ? "150,168,192" : "100,130,160"; // 山色：淡彩青灰
      var tree = dark ? "10,14,20" : "40,58,52"; // 近岸树林
      var mist = dark ? "150,166,190" : "255,255,255"; // 雾
      var mistK = dark ? 0.45 : 1; // 暗色下雾要收着些
      var ops = [];

      function haze(cy, hh, a) {
        // 一道横向雾带：拉开层与层的距离，即大气透视的魂
        ops.push({ haze: true, rgb: mist, a: a * mistK, y: cy - hh, h: hh * 2 });
      }

      function ridge(base, amp, wl) {
        // 三重正弦缓峰；波长按屏宽取，构图随窗口等比缩放
        var shares = [0.5, 0.3, 0.2], wv = [];
        for (var k = 0; k < 3; k++)
          wv.push([
            amp * shares[k],
            (Math.PI * 2) / ((wl / (1 + k * 1.8)) * (0.75 + rnd() * 0.5)),
            rnd() * Math.PI * 2,
          ]);
        var p = new Path2D();
        p.moveTo(0, waterY + 2);
        for (var x = 0; x <= w; x += 4) {
          var y = base;
          for (k = 0; k < 3; k++) y -= wv[k][0] * Math.sin(x * wv[k][1] + wv[k][2]);
          p.lineTo(x, y);
        }
        p.lineTo(w, waterY + 2);
        p.closePath();
        return p;
      }

      // 远山：山顶浓、山脚略淡（渐变底只到 60%，到 0 山体就断了）
      for (var i = 0; i < RANGES.length; i++) {
        var rg = RANGES[i], base = h * rg[0], amp = h * rg[1];
        ops.push({
          fill: ridge(base, amp, rg[2] * w),
          rgb: ink,
          a0: rg[3] * WASH,
          a1: rg[3] * WASH * 0.6,
          y0: base - amp,
          y1: waterY,
        });
        if (i < RANGES.length - 1) haze(base + amp * 0.5, amp * 1.2, 0.5);
      }

      // 一道水平亮雾：统一横切所有远山的山脚，令其齐齐没入雾中
      haze(waterY - h * 0.022, h * 0.034, 0.7);

      // 近岸树林：树冠高度按窗函数收到 0（两端真正沉入水中，否则就是两块灰方板）
      function land(x0, x1, base, amp, a) {
        var p = new Path2D(),
          p1 = rnd() * 6.28,
          p2 = rnd() * 6.28,
          p3 = rnd() * 6.28;
        p.moveTo(x0, waterY + 2);
        for (var x = x0; x <= x1; x += 3) {
          var u = (x - x0) / (x1 - x0); // 归一化：树形按岛宽缩放，不随窗口变形
          var win = Math.sin(Math.PI * u); // 两岸没入水中
          var top =
            amp * (0.55 + 0.45 * Math.sin(u * 11 + p1)) +
            amp * 0.45 * Math.sin(u * 30 + p2) +
            amp * 0.16 * Math.sin(u * 66 + p3);
          var y = waterY - (waterY - base + top) * win;
          if (y > waterY) y = waterY; // 树根不许越过水线
          p.lineTo(x, y);
        }
        p.lineTo(x1, waterY + 2);
        p.closePath();
        ops.push({
          fill: p,
          rgb: tree,
          a0: a * WASH,
          a1: a * WASH * 0.8,
          y0: base - amp,
          y1: waterY,
        });
      }
      land(w * 0.18, w * 0.56, h * TREELINE[0], h * TREELINE[1], TREELINE[2]); // 主岛
      land(
        w * 0.68,
        w * 0.9,
        h * (TREELINE[0] + 0.003),
        h * TREELINE[1] * 0.62,
        TREELINE[2] * 0.82
      );

      haze(waterY - h * 0.004, h * 0.018, 0.35); // 水线前的一线亮光
      MT.ops = ops;

      // 水色：水平线以下极淡一层青，把水面与天空分开
      MT.waterRgb = dark ? "120,140,168" : "110,135,155";
      MT.waterA0 = 0.07 * WASH;
      MT.waterA1 = 0.012 * WASH;

      // 倒影：按水平线镜像画同一批形状，再向下渐隐（水吸光）
      var rc = document.createElement("canvas");
      rc.width = w * DPR;
      rc.height = h * DPR;
      var r = rc.getContext("2d");
      r.setTransform(DPR, 0, 0, DPR, 0, 0); // 按设备像素渲染：不放大，所以不发虚
      r.save();
      r.translate(0, waterY * 2);
      r.scale(1, -1);
      r.globalAlpha = 0.35; // 倒影总比实体淡
      paint(r, w);
      r.restore();
      r.globalCompositeOperation = "destination-out";
      var mg = r.createLinearGradient(0, waterY, 0, h);
      mg.addColorStop(0, "rgba(0,0,0,0)");
      mg.addColorStop(0.3, "rgba(0,0,0,0.5)");
      mg.addColorStop(0.6, "rgba(0,0,0,0.9)");
      mg.addColorStop(1, "rgba(0,0,0,1)");
      r.fillStyle = mg;
      r.fillRect(0, waterY, w, h - waterY);
      r.globalCompositeOperation = "source-over";
      MT.refl = rc;

      // 扁舟：三叶，远近错落（d 越大离观者越近）
      var s0 = Math.max(0.8, Math.min(1.3, w / 1440));
      MT.boats = [
        { x: w * 0.24, s: s0 * 0.62, d: 2, ph: rnd() * 6.28, rod: 0 },
        { x: w * 0.5, s: s0 * 0.85, d: 5, ph: rnd() * 6.28, rod: 0 },
        { x: w * 0.72, s: s0 * 1.05, d: 9, ph: rnd() * 6.28, rod: 1 },
      ];
      MT.waterY = waterY;
      MT.ready = true;
    }

    function size() {
      c.__w = window.innerWidth;
      c.__h = window.innerHeight;
      c.width = c.__w * DPR;
      c.height = c.__h * DPR;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      ctx.lineCap = "round"; // 雨丝末端圆润，不生硬
      D.ripples = [];
      var n = Math.min(180, (c.__w / 12) | 0);
      for (var L = 0; L < 3; L++) {
        var s = Math.max(4, Math.round(n * SHARE[L]));
        var arr = D.layers[L];
        // 保留原有雨滴、只把坐标收进新窗口：拖窗口时雨不会一次次从头下
        for (var i = 0; i < arr.length; i++) {
          if (arr[i].x > c.__w) arr[i].x -= c.__w;
          if (arr[i].y > c.__h) arr[i].y = -20;
        }
        while (arr.length > s) arr.pop();
        while (arr.length < s) arr.push(newDrop(L, true));
      }
      if (mctx) {
        m.width = c.__w * DPR;
        m.height = c.__h * DPR;
        mctx.setTransform(DPR, 0, 0, DPR, 0, 0);
        MT.theme =
          document.documentElement.getAttribute("data-theme") === "dark"
            ? "dark"
            : "light";
        buildScene();
      }
    }
    size();

    if (!window.__rainInit) {
      window.__rainInit = 1;
      // 防抖：拖窗口时 resize 一秒能触发几十次，逐个重建会让背景疯狂闪变
      var rzT = 0;
      window.addEventListener("resize", function () {
        clearTimeout(rzT);
        rzT = setTimeout(function () {
          var el = document.getElementById("rain-canvas");
          if (el && el.__resize) el.__resize();
        }, 150);
      });
    }
    // 挂在元素上而非闭包里：视图切换换新画布后，resize 仍能找到当前那块
    c.__resize = function () {
      c.__gen = (c.__gen || 0) + 1;
      size();
      loop(c.__gen);
    };

    function loop(tok) {
      if (tok !== c.__gen || !c.isConnected) {
        c.__raf = 0;
        return;
      }
      var now = performance.now();
      var dtm = Math.min(3, Math.max(0.25, (now - last) / 16.667)); // 帧率无关
      last = now;
      var t = (now - T0) / 1000;
      // 风：缓慢往复的斜角，雨随之整体飘移
      var wind = 0.11 + 0.07 * Math.sin(t * 0.11) + 0.03 * Math.sin(t * 0.31 + 2);
      var dark =
        document.documentElement.getAttribute("data-theme") === "dark";
      var rgb = dark ? "214,222,234" : "40,45,55";
      ctx.clearRect(0, 0, c.__w, c.__h);
      ctx.lineWidth = 1;

      // —— 远景：三叠远山入雾 + 镜面水影 + 扁舟（留白为魂）——
      if (mctx && MT.ready) {
        var th = dark ? "dark" : "light";
        if (th !== MT.theme) {
          MT.theme = th; // 主题切换：整幅重建（换色，成本可忽略）
          buildScene();
        }
        mctx.clearRect(0, 0, c.__w, c.__h);
        // 水色（压在倒影之下）
        var wg = mctx.createLinearGradient(0, MT.waterY, 0, c.__h);
        wg.addColorStop(0, "rgba(" + MT.waterRgb + "," + MT.waterA0.toFixed(3) + ")");
        wg.addColorStop(1, "rgba(" + MT.waterRgb + "," + MT.waterA1.toFixed(3) + ")");
        mctx.fillStyle = wg;
        mctx.fillRect(0, MT.waterY, c.__w, c.__h - MT.waterY);
        // 倒影：横切分条，越靠画面下方摆动越大；源矩形按设备像素取
        var SL = 24, wh = c.__h - MT.waterY;
        for (var si = 0; si < SL; si++) {
          var y0 = MT.waterY + Math.round((wh * si) / SL);
          var y1 = MT.waterY + Math.round((wh * (si + 1)) / SL);
          var dp = si / SL;
          var sway = Math.sin(t * 0.7 + dp * 6.5) * (0.4 + 2.2 * dp * dp);
          mctx.drawImage(
            MT.refl,
            0,
            y0 * DPR,
            c.__w * DPR,
            (y1 - y0) * DPR,
            sway,
            y0,
            c.__w,
            y1 - y0
          );
        }
        // 远山本体：直接按设备像素绘制，文字不受影响也不发虚
        paint(mctx, c.__w);
        // 扁舟：极慢漂移、随波轻晃，各自带一痕倒影
        var bInk = dark ? "8,12,18" : "45,60,62";
        for (si = 0; si < MT.boats.length; si++) {
          var B = MT.boats[si];
          var bx = B.x + c.__w * 0.012 * Math.sin((t * Math.PI * 2) / 210 + B.ph);
          var by = MT.waterY + B.d + 1.1 * Math.sin((t * Math.PI * 2) / 8 + B.ph);
          mctx.save();
          mctx.translate(0, by * 1.7);
          mctx.scale(1, -0.7); // 倒影略压扁
          mctx.globalAlpha = 0.3;
          drawBoat(mctx, bx, by, B.s, 1, bInk, B.rod);
          mctx.restore();
          mctx.globalAlpha = 1;
          drawBoat(mctx, bx, by, B.s, (dark ? 0.5 : 0.42) * WASH, bInk, B.rod);
        }
      }

      // —— 雨丝：每层一次描边，淡墨深浅分远近 ——
      for (var L = 0; L < 3; L++) {
        ctx.strokeStyle = "rgba(" + rgb + "," + LAYERS[L][dark ? 1 : 0] + ")";
        ctx.beginPath();
        var arr = D.layers[L];
        for (var i = 0; i < arr.length; i++) {
          var d = arr[i];
          ctx.moveTo(d.x, d.y);
          ctx.lineTo(d.x + d.l * wind, d.y - d.l); // 雨尾顺着飘移方向
          d.y += d.v * dtm;
          d.x -= d.v * wind * dtm;
          if (d.x < -30) d.x += c.__w + 60; // 随风飘出边界后绕回
          else if (d.x > c.__w + 30) d.x -= c.__w + 60;
          if (d.y >= c.__h * (LAYERS[L][6] + d.b * LAYERS[L][7])) {
            ripple(d.x, c.__h * (LAYERS[L][6] + d.b * LAYERS[L][7]));
            arr[i] = newDrop(L, false);
          }
        }
        ctx.stroke();
      }

      // —— 涟漪：墨环先快后慢地晕开，渐渐淡去、压扁 ——
      for (var j = D.ripples.length - 1; j >= 0; j--) {
        var r = D.ripples[j];
        r.t += dtm / RIPPLE_LIFE;
        if (r.t < 0) continue; // 第二圈的迟滞
        if (r.t >= 1) {
          D.ripples.splice(j, 1);
          continue;
        }
        var e = 1 - Math.pow(1 - r.t, 3); // easeOutCubic：先快后慢
        var a = (dark ? 0.34 : 0.3) * Math.pow(1 - r.t, 1.6);
        var rad = 1 + r.max * e;
        ctx.strokeStyle = "rgba(" + rgb + "," + a.toFixed(3) + ")";
        ctx.beginPath();
        ctx.ellipse(r.x, r.y, rad, rad * (0.34 - 0.12 * r.t), 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      c.__raf = requestAnimationFrame(function () {
        loop(tok);
      });
    }
    c.__gen = 1;
    loop(1);
  })();
</script>

<style>
  .mist-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1; /* 垫在正文之后、页面底色之上 */
    pointer-events: none;
  }
  .rain-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }
</style>

<!--
  雨特效：全站覆盖、不挡交互（pointer-events: none）。
  data-astro-rerun 保证视图切换后重新绑定；尊重系统"减少动态效果"设置。
-->
<canvas id="rain-canvas" class="rain-canvas" aria-hidden="true"></canvas>

<script is:inline data-astro-rerun>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var c = document.getElementById("rain-canvas");
    if (!c || c.__raf) return;
    var ctx = c.getContext("2d");
    var DPR = Math.min(window.devicePixelRatio || 1, 2);

    function drop(any) {
      return {
        x: Math.random() * c.__w,
        y: any ? Math.random() * c.__h : -20,
        l: 12 + Math.random() * 18,
        v: 24 + Math.random() * 18,
      };
    }
    function size() {
      c.__w = window.innerWidth;
      c.__h = window.innerHeight;
      c.width = c.__w * DPR;
      c.height = c.__h * DPR;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      c.__drops = Array.from({ length: (c.__w / 12) | 0 }, function () {
        return drop(true);
      });
    }
    size();
    if (!window.__rainInit) {
      window.__rainInit = 1;
      window.addEventListener("resize", function () {
        var el = document.getElementById("rain-canvas");
        if (el && el.__raf) el.__raf = 0, start(el);
      });
    }
    function start(el) {
      if (el !== c) return;
      size();
      loop();
    }
    function loop() {
      if (!c.isConnected) {
        c.__raf = 0;
        return;
      }
      ctx.clearRect(0, 0, c.__w, c.__h);
      ctx.strokeStyle = "rgba(148, 163, 184, 0.35)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (var i = 0; i < c.__drops.length; i++) {
        var d = c.__drops[i];
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(d.x - d.l * 0.08, d.y + d.l);
        d.y += d.v;
        if (d.y > c.__h) c.__drops[i] = drop(false);
      }
      ctx.stroke();
      c.__raf = requestAnimationFrame(loop);
    }
    loop();
  })();
</script>

<style>
  .rain-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }
</style>

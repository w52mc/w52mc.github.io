---
/**
 * 今日古诗词
 *
 * 首屏直接渲染一句本地诗词（构建时随机），页面打开立刻可见，不等待网络。
 * 客户端后台请求「今日诗词」接口，成功后替换；失败或超时则随机换一句本地诗词。
 */
import { poems } from "@/data/poems";

const idx = Math.floor(Math.random() * poems.length);
const initial = poems[idx]!;
---

<section class="poem" aria-label="今日古诗词">
  <blockquote class="poem-body">
    <p class="poem-item" data-poem>
      <span class="poem-text" data-poem-text>{initial.text}</span>
      <cite class="poem-source" data-poem-source
        >—— {initial.author}《{initial.title}》</cite
      >
    </p>
  </blockquote>
</section>

<script>
  import { poems } from "@/data/poems";

  const API = "https://v2.jinrishici.com/one.json";

  function render(text: string, source: string) {
    const textEl = document.querySelector("[data-poem-text]");
    const sourceEl = document.querySelector("[data-poem-source]");
    if (textEl) (textEl as HTMLElement).textContent = text;
    if (sourceEl) (sourceEl as HTMLElement).textContent = source;
  }

  function randomLocal() {
    const poem = poems[Math.floor(Math.random() * poems.length)];
    if (poem) render(poem.text, `—— ${poem.author}《${poem.title}》`);
  }

  async function loadPoem() {
    try {
      // 4 秒超时，接口慢就直接用本地诗词，不再等待
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 4000);
      const res = await fetch(API, {
        cache: "no-store",
        signal: controller.signal,
      });
      clearTimeout(timer);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const json = await res.json();
      const content: string | undefined = json?.data?.content;
      if (!content) throw new Error("接口未返回诗句");

      const origin = json?.data?.origin ?? {};
      const author = origin.author ?? "";
      const title = origin.title ? `《${origin.title}》` : "";
      render(content, `—— ${author}${title}`.trim());
    } catch {
      randomLocal();
    }
  }

  loadPoem();
  document.addEventListener("astro:page-load", loadPoem);
</script>

<style>
  .poem {
    margin-top: 3.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .poem-body {
    margin: 0;
  }

  .poem-item {
    margin: 0;
  }

  .poem-text {
    display: block;
    font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--muted-foreground);
  }

  .poem-source {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.78rem;
    font-style: normal;
    color: var(--muted-foreground);
    opacity: 0.7;
  }
</style>

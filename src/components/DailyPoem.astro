---
/**
 * 今日古诗词
 *
 * 加载策略（关键）：
 *   1. 服务端先渲染一句（构建时随机）—— 保证无 JS 时也有内容，且不会空白
 *   2. 内联脚本在「首次绘制前」同步执行，立刻渲染一句诗（优先用上次缓存的接口诗句，
 *      否则从本地库随机）—— 因此页面一出现就是最终内容，看不到"换句"的闪烁
 *   3. 后台请求「今日诗词」接口，结果缓存起来供「下次刷新」使用
 *      —— 所以每次刷新都是新的诗句，但本次不会替换，避免闪一下
 */
import { poems } from "@/data/poems";

const idx = Math.floor(Math.random() * poems.length);
const initial = poems[idx]!;
---

<section class="poem" aria-label="今日古诗词">
  <blockquote class="poem-body">
    <p class="poem-item" data-poem>
      <span class="poem-text" data-poem-text>{initial.text}</span>
      <cite class="poem-source" data-poem-source
        >—— {initial.author}《{initial.title}》</cite
      >
    </p>
  </blockquote>
</section>

<script
  type="application/json"
  id="poem-corpus"
  set:html={JSON.stringify(poems)}
></script>

<script is:inline>
  // 在首次绘制前同步执行：立刻决定显示哪一句，避免任何可见的"换句"
  (function () {
    var t = document.querySelector("[data-poem-text]");
    var s = document.querySelector("[data-poem-source]");
    if (!t || !s) return;

    // 优先使用上次接口取到的诗句
    var cached = null;
    try {
      cached = JSON.parse(localStorage.getItem("daily-poem") || "null");
    } catch (e) {}

    if (cached && cached.text) {
      t.textContent = cached.text;
      s.textContent = cached.source || "";
      return;
    }

    // 没有缓存就随机取一句本地诗词
    try {
      var el = document.getElementById("poem-corpus");
      var list = JSON.parse(el.textContent);
      var p = list[Math.floor(Math.random() * list.length)];
      t.textContent = p.text;
      s.textContent = "—— " + p.author + "《" + p.title + "》";
    } catch (e) {}
  })();
</script>

<script>
  // 后台预取，存起来供下次刷新使用（本次不替换，因此不会闪烁）
  (async function () {
    try {
      const res = await fetch("https://v2.jinrishici.com/one.json", {
        cache: "no-store",
      });
      if (!res.ok) return;
      const json = await res.json();
      const d = json && json.data;
      if (!d || !d.content) return;
      const o = d.origin || {};
      localStorage.setItem(
        "daily-poem",
        JSON.stringify({
          text: d.content,
          source:
            "—— " + (o.author || "") + (o.title ? `《${o.title}》` : ""),
        })
      );
    } catch {
      // 接口不可用就继续用本地库，不影响显示
    }
  })();
</script>

<style>
  .poem {
    margin-top: 3.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .poem-body {
    margin: 0;
  }

  .poem-item {
    margin: 0;
  }

  .poem-text {
    display: block;
    font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--muted-foreground);
  }

  .poem-source {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.78rem;
    font-style: normal;
    color: var(--muted-foreground);
    opacity: 0.7;
  }
</style>

---
/**
 * 今日古诗词
 *
 * 数据来自「今日诗词」开放接口 https://www.jinrishici.com
 * 每次刷新页面重新请求，因此每次看到的都不一样。
 *
 * 网络异常或接口不可用时，退回本地诗词库随机取一句（见 src/data/poems.ts）。
 */
import { poems } from "@/data/poems";
---

<section class="poem" aria-label="今日古诗词">
  <blockquote class="poem-body">
    <p class="poem-item" data-poem>
      <span class="poem-text" data-poem-text></span>
      <cite class="poem-source" data-poem-source></cite>
    </p>
  </blockquote>
</section>

<script>
  import { poems } from "@/data/poems";

  const API = "https://v2.jinrishici.com/one.json";

  function render(text: string, source: string) {
    const textEl = document.querySelector("[data-poem-text]");
    const sourceEl = document.querySelector("[data-poem-source]");
    if (!textEl) return;
    (textEl as HTMLElement).textContent = text;
    if (sourceEl) (sourceEl as HTMLElement).textContent = source;
  }

  function fallback() {
    const poem = poems[Math.floor(Math.random() * poems.length)];
    if (!poem) return;
    render(poem.text, `—— ${poem.author}《${poem.title}》`);
  }

  async function loadPoem() {
    try {
      const res = await fetch(API, { cache: "no-store" });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      const data = json?.data;
      const content: string | undefined = data?.content;
      if (!content) throw new Error("接口未返回诗句");

      const origin = data?.origin ?? {};
      const author = origin.author ? `${origin.author}` : "";
      const title = origin.title ? `《${origin.title}》` : "";
      render(content, `—— ${author}${title}`.trim());
    } catch {
      fallback();
    }
  }

  loadPoem();
  document.addEventListener("astro:page-load", loadPoem);
</script>

<style>
  .poem {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .poem-body {
    margin: 0;
  }

  .poem-item {
    margin: 0;
    min-height: 3.2rem;
  }

  .poem-text {
    display: block;
    font-family: "Songti SC", "STSong", "SimSun", Georgia, serif;
    font-size: 1.05rem;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
  }

  .poem-source {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.78rem;
    font-style: normal;
    letter-spacing: 0.02em;
    color: var(--muted-foreground);
    opacity: 0.7;
  }
</style>

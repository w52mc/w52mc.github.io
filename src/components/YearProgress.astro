---
/**
 * 年份进度条
 *
 * 行为：
 *   页面加载时 → 进度条填充 + 百分比淡入
 *   停留约 2 秒 → 淡出，只留一根细横线
 *   鼠标悬停   → 进度和百分比重新显示
 */

const now = new Date();
const year = now.getFullYear();

const startOfYear = new Date(year, 0, 1).getTime();
const startOfNextYear = new Date(year + 1, 0, 1).getTime();
const elapsed = now.getTime() - startOfYear;
const total = startOfNextYear - startOfYear;

const percent = Math.min(100, Math.max(0, (elapsed / total) * 100));
const percentLabel = percent.toFixed(1).replace(/\.0$/, "");
---

<div
  class="year-progress"
  title={`${year} 年已过去 ${percentLabel}%`}
  aria-label={`${year} 年已过去 ${percentLabel}%`}
>
  <span class="year-progress-track">
    <span class="year-progress-fill" style={`--target: ${percent.toFixed(3)}%`}
    ></span>
    <span class="year-progress-percent">{percentLabel}%</span>
  </span>
</div>

<style>
  .year-progress {
    width: 100%;
    padding-top: 0.6rem;
    user-select: none;
    cursor: default;
  }

  /* 底：一根细横线（常驻） */
  .year-progress-track {
    position: relative;
    display: block;
    width: 100%;
    height: 1rem;
    border-radius: 999px;
    overflow: hidden;
  }

  /* 进度条下方那条细线 */
  .year-progress-track::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 50%;
    height: 1px;
    background: var(--border);
    transform: translateY(-50%);
  }

  /* 填充部分 */
  .year-progress-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: var(--target);
    background: var(--muted-foreground);
    border-radius: 999px;
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* 中间的百分比 */
  .year-progress-percent {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--foreground);
    opacity: 0;
    pointer-events: none;
  }

  /* ── 页面加载时：填充 + 淡入，停留后淡出 ── */

  @keyframes fill-in {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }
    12% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @keyframes fade-hold-away {
    0%,
    55% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .year-progress-fill {
    animation: fill-in 1.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  .year-progress-percent {
    animation: fade-hold-away 3s ease-out backwards;
    opacity: 1;
  }

  /* ── 悬停：重新显示 ── */

  .year-progress:hover .year-progress-fill {
    opacity: 1;
    transform: scaleX(1);
    transition:
      opacity 0.25s ease-out,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .year-progress:hover .year-progress-percent {
    opacity: 1;
    transition: opacity 0.3s ease-out;
  }

  /* 键盘用户：聚焦时也显示 */
  .year-progress:focus-visible .year-progress-fill {
    opacity: 1;
    transform: scaleX(1);
  }

  .year-progress:focus-visible .year-progress-percent {
    opacity: 1;
  }

  /* ── 尊重「减少动态效果」设置 ── */

  @media (prefers-reduced-motion: reduce) {
    .year-progress-fill {
      animation: none;
      opacity: 0;
      transform: scaleX(0);
    }

    .year-progress-percent {
      animation: none;
      opacity: 0;
    }

    .year-progress:hover .year-progress-fill,
    .year-progress:hover .year-progress-percent {
      opacity: 1;
      transform: scaleX(1);
    }
  }
</style>
